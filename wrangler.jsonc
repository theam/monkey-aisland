{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monkey-aisland",
  // The game is static files. The Worker only answers /api/event: it checks
  // analytics events and forwards them to PostHog with a token kept in its
  // secrets (POSTHOG_KEY, and optionally POSTHOG_DEV_KEY), so no token ever
  // reaches the browser.
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    // Events from these hosts go to the production project; any other host
    // (preview URLs, wrangler dev) to the development one.
    "PRODUCTION_HOSTS": "monkeyaisland.theagilemonkeys.com,monkey-aisland.the-agile-monkeys-innovation-lab.workers.dev"
  },
  // A real visit sends a dozen events over several minutes. Sixty a minute from
  // one address leaves room for an office full of players behind one IP and
  // still bounds what a script can pour in.
  "ratelimits": [
    {
      "name": "EVENT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
